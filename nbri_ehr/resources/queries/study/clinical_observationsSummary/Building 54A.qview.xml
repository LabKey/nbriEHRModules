<customView xmlns="http://labkey.org/data/xml/queryCustomView" canOverride="true">
    <sorts>
        <sort column="date" descending="true"/>
    </sorts>
    <columns>
        <column name="Id"/>
        <column name="Id/Demographics/species"/>
        <column name="Id/curLocation/cage/room/floor/building"/>
        <column name="Id/curLocation/cage"/>
        <column name="date"/>
        <column name="category"/>
        <column name="area"/>
        <column name="observation"/>
        <column name="remark"/>
        <column name="performedBy"/>
        <column name="QCState"/>
    </columns>
    <filters>
        <filter column="Id/curLocation/room/floor/building/Description" operator="eq" value="Building 54A"/>
    </filters>
</customView>