<query xmlns="http://labkey.org/data/xml/query">
    <metadata>
        <tables xmlns="http://labkey.org/data/xml">
            <table tableName="necropsyFinal" tableDbType="TABLE">
                <tableTitle>Necropsy Final</tableTitle>
                <columns>
                    <column columnName="date">
                        <columnTitle>Final Diagnosis Date</columnTitle>
                        <formatString>DateTime</formatString>
                    </column>
                    <column columnName="causeCategory">
                        <columnTitle>Cause of Death Category</columnTitle>
                        <description>The underlying disease or injury that started the events leading to death, not the mechanism such as organ failure.</description>
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>necropsy_cause_category</fkTable>
                            <fkColumnName>value</fkColumnName>
                        </fk>
                    </column>
                    <column columnName="remark">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="performedby">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="project">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="description">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="taskid">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="necropsyStatus">
                        <columnTitle>Necropsy Status</columnTitle>
                        <conditionalFormats>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Request Pending"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Preliminary Results Submitted"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Final Results Submitted: Pending Addendum"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                        </conditionalFormats>
                    </column>
                </columns>
            </table>
        </tables>
    </metadata>
</query>
