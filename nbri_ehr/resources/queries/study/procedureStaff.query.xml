<query xmlns="http://labkey.org/data/xml/query">
    <metadata>
        <tables xmlns="http://labkey.org/data/xml">
            <table tableName="procedureStaff" tableDbType="TABLE">
                <tableTitle>Procedure Staff</tableTitle>
                <columns>
                    <column columnName="staff">
                        <columnTitle>Staff</columnTitle>
                        <fk>
                            <fkDbSchema>core</fkDbSchema>
                            <fkTable>usernames</fkTable>
                            <fkColumnName>DisplayName</fkColumnName>
                            <fkDisplayColumnName useRawValue="true"/>
                        </fk>
                    </column>
                    <column columnName="role">
                        <columnTitle>Role</columnTitle>
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>encounter_roles</fkTable>
                            <fkColumnName>value</fkColumnName>
                        </fk>
                    </column>
                    <column columnName="performedby">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="project">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="description">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="taskid">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="necropsyStatus">
                        <columnTitle>Necropsy Status</columnTitle>
                        <conditionalFormats>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Request Pending"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Preliminary Results Submitted"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Final Results Submitted: Pending Addendum"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                        </conditionalFormats>
                    </column>
                </columns>
            </table>
        </tables>
    </metadata>
</query>
