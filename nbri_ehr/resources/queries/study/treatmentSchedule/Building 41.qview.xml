<customView xmlns="http://labkey.org/data/xml/queryCustomView" canOverride="true">
    <columns>
        <column name="treatmentRecord"/>
        <column name="Id"/>
        <column name="Id/Demographics/species"/>
        <column name="Id/curLocation/room/floor/building"/>
        <column name="Id/curLocation/cage"/>

        <column name="date"/>
        <column name="daysElapsed"/>

        <column name="frequency"/>
        <column name="code"/>
        <column name="amountAndVolume"/>
        <column name="route"/>
        <column name="remark"/>
        <column name="orderedby"/>
        <column name="startDate"/>
        <column name="category"/>
        <column name="reason" />
        <column name="treatmentStatus" />
    </columns>
    <sorts>
        <sort column="date"/>
        <sort column="Id/curLocation/cage"/>
    </sorts>
    <filters>
        <filter column="Id/curLocation/room/floor/building/Description" operator="eq" value="Building 41"/>
    </filters>
</customView>