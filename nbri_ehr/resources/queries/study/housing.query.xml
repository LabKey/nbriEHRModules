<query xmlns="http://labkey.org/data/xml/query">
    <metadata>
        <tables xmlns="http://labkey.org/data/xml">
            <table tableName="housing" tableDbType="TABLE" useColumnOrder="true">
                <columns>
                    <column columnName="Id"/>
                    <column columnName="date">
                        <columnTitle>In Date</columnTitle>
                    </column>
                    <column columnName="enddate">
                        <nullable>true</nullable>
                        <isHidden>false</isHidden>
                        <shownInInsertView>true</shownInInsertView>
                        <shownInDetailsView>true</shownInDetailsView>
                        <columnTitle>Out Date</columnTitle>
                    </column>
                    <column columnName="cage">
                        <columnTitle>Location</columnTitle>
                        <url>/nbri_ehr/cageDetails.view?room=${room}&amp;cage=${cage}&amp;</url>
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>cage</fkTable>
                            <fkColumnName>location</fkColumnName>
                            <fkDisplayColumnName>cage</fkDisplayColumnName>
                        </fk>
                    </column>
                    <column columnName="room">
                        <columnTitle>Room</columnTitle>
                        <url>/nbri_ehr/cageDetails.view?room=${room}&amp;</url>
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>rooms</fkTable>
                            <fkColumnName>room</fkColumnName>
                            <fkDisplayColumnName>name</fkDisplayColumnName>
                        </fk>
                    </column>
                    <column columnName="reason">
                        <columnTitle>Reason For Move</columnTitle>
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>housing_reason</fkTable>
                            <fkColumnName>value</fkColumnName>
                        </fk>
                    </column>
                    <column columnName="remark"/>
                    <column columnName="performedBy">
                    </column>
                    <!-- Re-declared from ehr/queries/study/housing.query.xml; this file replaces
                         ehr's rather than merging with it. See weight.query.xml.

                         fkColumnName deliberately differs from ehr: ehr (and jhu, onprc, snprc,
                         tnprc, wnprc) all say objectid, but study.housingTotalRoommates selects
                         only lsid and TotalRoommates. With objectid the wrapper column appears in
                         getQueryDetails yet the join never resolves: TotalRoommates/TotalRoommates
                         is silently dropped from selectRows and LabKey SQL reports
                         "Unknown field". With lsid it returns real cagemate counts. -->
                    <column columnName="TotalRoommates" wrappedColumnName="lsid">
                        <columnTitle>Total Cagemates</columnTitle>
                        <isHidden>false</isHidden>
                        <isUnselectable>true</isUnselectable>
                        <fk>
                            <fkDbSchema>study</fkDbSchema>
                            <fkTable>housingTotalRoommates</fkTable>
                            <fkColumnName>lsid</fkColumnName>
                        </fk>
                    </column>
                </columns>
            </table>
        </tables>
    </metadata>
</query>