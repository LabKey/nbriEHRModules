<customView xmlns="http://labkey.org/data/xml/queryCustomView" canOverride="true">
    <columns>
        <column name="procedureRecord"/>
        <column name="Id"/>
        <column name="Id/Demographics/species"/>
        <column name="Id/curLocation/room/floor/building"/>
        <column name="Id/curLocation/cage"/>
        <column name="date"/>
        <column name="procedure"/>
        <column name="windowStart"/>
        <column name="windowEnd"/>
        <column name="remark"/>
        <column name="status"/>
    </columns>
    <filters>
        <filter column="Id/Demographics/calculated_status" operator="eq" value="Alive"/>
    </filters>
    <sorts>
        <sort column="status" descending="false"/>
        <sort column="Id/curLocation/room/floor/building"/>
        <sort column="Id/curLocation/cage"/>
    </sorts>
</customView>