<query xmlns="http://labkey.org/data/xml/query">
    <metadata>
        <tables xmlns="http://labkey.org/data/xml">
            <table tableName="finalDiagnoses" tableDbType="TABLE">
                <tableTitle>Final Diagnoses</tableTitle>
                <columns>
                    <column columnName="tissueSample">
                        <columnTitle>Organ/Tissue</columnTitle>
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>tissue</fkTable>
                            <fkColumnName>value</fkColumnName>
                        </fk>
                    </column>
                    <column columnName="diagnosis">
                        <columnTitle>Diagnosis</columnTitle>
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>necropsy_diagnosis</fkTable>
                            <fkColumnName>value</fkColumnName>
                        </fk>
                    </column>
                    <column columnName="severity">
                        <columnTitle>Severity</columnTitle>
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>necropsy_diagnosis_severity</fkTable>
                            <fkColumnName>value</fkColumnName>
                        </fk>
                    </column>
                    <column columnName="distribution">
                        <columnTitle>Distribution</columnTitle>
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>necropsy_diagnosis_distribution</fkTable>
                            <fkColumnName>value</fkColumnName>
                        </fk>
                    </column>
                    <column columnName="project">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="description">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="taskid">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="necropsyStatus">
                        <columnTitle>Necropsy Status</columnTitle>
                        <conditionalFormats>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Request Pending"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Preliminary Results Submitted"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Final Results Submitted: Pending Addendum"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                        </conditionalFormats>
                    </column>
                </columns>
            </table>
        </tables>
    </metadata>
</query>
