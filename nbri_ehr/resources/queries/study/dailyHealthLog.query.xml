<query xmlns="http://labkey.org/data/xml/query">
    <metadata>
        <tables xmlns="http://labkey.org/data/xml">
            <table tableName="dailyHealthLog" tableDbType="TABLE" useColumnOrder="true">
                <tableTitle>Daily Health Log</tableTitle>
                <columns>
                    <column columnName="Id"/>
                    <column columnName="date">
                        <columnTitle>Observation Date</columnTitle>
                    </column>
                    <column columnName="logEntryId">
                        <columnTitle>Log Entry Id</columnTitle>
                        <required>true</required>
                    </column>
                    <column columnName="sortOrder">
                        <columnTitle>Sort Order</columnTitle>
                        <required>true</required>
                    </column>
                    <column columnName="code">
                        <columnTitle>Code</columnTitle>
                        <required>true</required>
                        <fk>
                            <fkDbSchema>nbri_ehr</fkDbSchema>
                            <fkTable>dailyHealthCode</fkTable>
                            <fkColumnName>code</fkColumnName>
                        </fk>
                    </column>
                    <column columnName="performedby">
                        <columnTitle>Technician</columnTitle>
                        <required>true</required>
                    </column>
                    <column columnName="remark"/>
                </columns>
            </table>
        </tables>
    </metadata>
</query>
