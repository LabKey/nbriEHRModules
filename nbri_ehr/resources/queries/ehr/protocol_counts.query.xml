<query xmlns="http://labkey.org/data/xml/query">
    <metadata>
        <tables xmlns="http://labkey.org/data/xml">
            <table tableName="protocol_counts" tableDbType="TABLE">
                <tableTitle>NHPs Allowed Per Protocol</tableTitle>
                <javaCustomizer class="org.labkey.nbri_ehr.table.NBRI_EHRCustomizer" />
                <columns>
                    <column columnName="species">
                        <columnTitle>Species</columnTitle>
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>species_codes</fkTable>
                            <fkColumnName>code</fkColumnName>
                            <fkDisplayColumnName>common_name</fkDisplayColumnName>
                        </fk>
                    </column>
                    <column columnName="allowed">
                        <columnTitle># Animals Allowed</columnTitle>
                    </column>
                    <!-- start and enddate are not used here: a count's window is its amendment's effectiveDate..endDate -->
                    <column columnName="start">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="enddate">
                        <isHidden>true</isHidden>
                    </column>
                    <column columnName="amendmentId">
                        <columnTitle>Amendment</columnTitle>
                        <description>The amendment that approved this count; the row is only in effect once that amendment is approved</description>
                        <fk>
                            <fkDbSchema>nbri_ehr</fkDbSchema>
                            <fkTable>ProtocolAmendment</fkTable>
                            <fkColumnName>objectid</fkColumnName>
                            <fkDisplayColumnName>rowid</fkDisplayColumnName>
                        </fk>
                    </column>
                    <column columnName="taskid">
                        <columnTitle>Task Id</columnTitle>
                        <facetingBehavior>ALWAYS_OFF</facetingBehavior>
                        <fk>
                            <fkDbSchema>ehr</fkDbSchema>
                            <fkTable>tasks</fkTable>
                            <fkColumnName>taskid</fkColumnName>
                            <fkDisplayColumnName>rowid</fkDisplayColumnName>
                        </fk>
                        <url>/ehr/dataEntryFormDetails.view?formType=${taskid/formtype}&amp;taskid=${taskid}</url>
                    </column>
                </columns>
            </table>
        </tables>
    </metadata>
</query>
