<query xmlns="http://labkey.org/data/xml/query">
    <metadata>
        <tables xmlns="http://labkey.org/data/xml">
            <table tableName="necropsyTask" tableDbType="TABLE" useColumnOrder="true">
                <javaCustomizer class="org.labkey.nbri_ehr.table.NBRI_EHRCustomizer"/>
                <importUrl/>
                <insertUrl/>
                <updateUrl/>
                <tableTitle>Necropsies</tableTitle>
                <buttonBarOptions position="both" includeStandardButtons="true">
                    <includeScript>nbri_ehr/buttons/necropsyReportButtons.js</includeScript>
                    <item text="Print Reports">
                        <item text="Full Report">
                            <onClick>NBRI_EHR.NecropsyReportButtons.openReport(dataRegion, false);</onClick>
                        </item>
                        <item text="Redacted Report">
                            <onClick>NBRI_EHR.NecropsyReportButtons.openReport(dataRegion, true);</onClick>
                        </item>
                    </item>
                </buttonBarOptions>
                <columns>
                    <column columnName="Task">
                        <url>/ehr-dataEntryFormDetails.view?formType=Necropsy Request&amp;taskId=${taskid}</url>
                    </column>
                    <column columnName="Date">
                        <columnTitle>Date of Request</columnTitle>
                    </column>
                    <column columnName="AssignedTo">
                        <fk>
                            <fkDbSchema>core</fkDbSchema>
                            <fkTable>PrincipalsWithoutAdmin</fkTable>
                            <fkColumnName>UserId</fkColumnName>
                        </fk>
                    </column>
                    <column columnName="SubmittingVet">
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>veterinarians</fkTable>
                            <fkColumnName>UserId</fkColumnName>
                            <fkDisplayColumnName>DisplayName</fkDisplayColumnName>
                        </fk>
                    </column>
                    <column columnName="PriorityCode">
                        <fk>
                            <fkDbSchema>ehr_lookups</fkDbSchema>
                            <fkTable>necropsy_priority</fkTable>
                            <fkColumnName>value</fkColumnName>
                        </fk>
                    </column>
                    <column columnName="status">
                        <columnTitle>Necropsy Status</columnTitle>
                        <conditionalFormats>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Request Pending"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Preliminary Results Submitted"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Final Results Submitted: Pending Addendum"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                        </conditionalFormats>
                    </column>
                    <column columnName="taskid">
                        <fk>
                            <fkDbSchema>ehr</fkDbSchema>
                            <fkTable>tasks</fkTable>
                            <fkColumnName>taskid</fkColumnName>
                        </fk>
                    </column>
                    <column columnName="QCState">
                        <columnTitle>QC State</columnTitle>
                        <isHidden>false</isHidden>
                        <fk>
                            <fkDbSchema>core</fkDbSchema>
                            <fkTable>QCState</fkTable>
                            <fkColumnName>rowid</fkColumnName>
                        </fk>
                        <conditionalFormats>
                            <conditionalFormat>
                                <filters>
                                    <filter operator="eq" value="Review Required"/>
                                </filters>
                                <backgroundColor>FBEC5D</backgroundColor>
                            </conditionalFormat>
                        </conditionalFormats>
                    </column>
                </columns>
            </table>
        </tables>
    </metadata>
</query>
