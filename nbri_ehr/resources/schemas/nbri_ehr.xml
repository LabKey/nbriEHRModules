<?xml version="1.0" encoding="UTF-8"?>
<tables xsi:schemaLocation="http://labkey.org/data/xml ..\..\..\..\..\schemas\tableInfo.xsd"
        xmlns="http://labkey.org/data/xml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <table tableName="Conception" tableDbType="TABLE">
        <tableTitle>Conception</tableTitle>
        <auditLogging>DETAILED</auditLogging>
        <columns>
            <column columnName="RowId"/>
            <column columnName="ConceptId"/>
            <column columnName="ConceptDate">
                <formatString>Date</formatString>
            </column>
            <column columnName="Estimated"/>
            <column columnName="Remark"/>
            <column columnName="Dam"/>
            <column columnName="Sire"/>
            <column columnName="TaskId"/>
            <column columnName="QCState"/>
            <column columnName="Container"/>
            <column columnName="Created"/>
            <column columnName="CreatedBy"/>
            <column columnName="Modified"/>
            <column columnName="ModifiedBy"/>
        </columns>
    </table>

    <table tableName="ProtocolAmendment" tableDbType="TABLE">
        <tableTitle>protocol Amendment</tableTitle>
        <auditLogging>DETAILED</auditLogging>
        <columns>
            <column columnName="rowid"/>
            <column columnName="protocol"/>
            <column columnName="amendmentType"/>
            <column columnName="status"/>
            <column columnName="cycle"/>
            <column columnName="revision"/>
            <column columnName="date">
                <formatString>Date</formatString>
            </column>
            <column columnName="submittedDate">
                <formatString>Date</formatString>
            </column>
            <column columnName="approvedDate">
                <formatString>Date</formatString>
            </column>
            <column columnName="effectiveDate">
                <formatString>Date</formatString>
            </column>
            <column columnName="enddate">
                <formatString>Date</formatString>
            </column>
            <column columnName="newExpirationDate">
                <formatString>Date</formatString>
            </column>
            <column columnName="amendmentReason"/>
            <column columnName="remark"/>
            <column columnName="taskid"/>
            <column columnName="QCState"/>
            <column columnName="objectid"/>
            <column columnName="Container"/>
            <column columnName="Created"/>
            <column columnName="CreatedBy"/>
            <column columnName="Modified"/>
            <column columnName="ModifiedBy"/>
        </columns>
    </table>

</tables>
