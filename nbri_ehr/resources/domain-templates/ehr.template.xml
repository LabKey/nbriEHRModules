<?xml version="1.0" encoding="UTF-8"?>
<templates xmlns="http://labkey.org/data/xml/domainTemplate"
           xmlns:dat="http://labkey.org/data/xml"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <template xsi:type="EHRTemplateType">
        <table tableName="protocol" tableDbType="TABLE">
            <dat:columns>
                <dat:column columnName="inactiveDate">
                    <dat:rangeURI>dateTime</dat:rangeURI>
                </dat:column>
                <dat:column columnName="exemptFood">
                    <dat:rangeURI>boolean</dat:rangeURI>
                </dat:column>
                <dat:column columnName="exemptHousing">
                    <dat:rangeURI>boolean</dat:rangeURI>
                </dat:column>
                <dat:column columnName="exemptPairing">
                    <dat:rangeURI>boolean</dat:rangeURI>
                </dat:column>
            </dat:columns>
        </table>
    </template>

    <template xsi:type="EHRTemplateType">
        <table tableName="protocol_counts" tableDbType="TABLE">
            <dat:columns>
                <!-- objectid of the nbri_ehr.ProtocolAmendment this count belongs to. The amendment form declares
                     this as the child sections's isParentField, so ParentClientStore writes the parent's objectid
                     here. A count row is only in effect once its amendment is approved. -->
                <dat:column columnName="amendmentId">
                    <dat:rangeURI>string</dat:rangeURI>
                    <dat:scale>36</dat:scale>
                </dat:column>
                <!-- stamped by the task framework; lets a saved task reload its own count rows -->
                <dat:column columnName="taskid">
                    <dat:rangeURI>string</dat:rangeURI>
                    <dat:scale>36</dat:scale>
                </dat:column>
            </dat:columns>
        </table>
    </template>

</templates>
