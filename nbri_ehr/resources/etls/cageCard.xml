<?xml version="1.0" encoding="UTF-8"?>
<etl xmlns="http://labkey.org/etl/xml">
    <name>Cage Card</name>
    <description>Cage Card data</description>
    <transforms>
        <transform id="step1" type="org.labkey.di.pipeline.TransformTask">
            <description>Copy to cage card target</description>
            <source schemaName="dbo" queryName="q_cage_card"/>
            <destination schemaName="nbri_ehr" queryName="CageCard"
                         bulkLoad="true" targetOption="truncate">
                <columnTransforms>
                    <column source="AccountStaff" target="AccountStaff" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                    <column source="AnimalRequestedByStaff" target="AnimalRequestedByStaff" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                </columnTransforms>
            </destination>
        </transform>
        <transform id="step2" type="org.labkey.di.pipeline.TransformTask">
            <description>Copy to cage card history target</description>
            <source schemaName="dbo" queryName="q_cage_card_history"/>
            <destination schemaName="nbri_ehr" queryName="CageCardHistory"
                         bulkLoad="true" targetOption="truncate">
                <columnTransforms>
                    <column source="AccountStaff" target="AccountStaff" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                    <column source="AnimalRequestedByStaff" target="AnimalRequestedByStaff" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                </columnTransforms>
            </destination>
        </transform>
    </transforms>

    <schedule>
        <cron expression="0 0 20 * * ?" /> <!--Run at 8PM every day-->
    </schedule>
</etl>