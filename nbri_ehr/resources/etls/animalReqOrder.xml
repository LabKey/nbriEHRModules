<?xml version="1.0" encoding="UTF-8"?>
<etl xmlns="http://labkey.org/etl/xml">
    <name>Animal Req Order</name>
    <description>Animal req order data</description>
    <transforms>
        <transform id="step1" type="org.labkey.di.pipeline.TransformTask">
            <description>Copy to req order target</description>
            <source schemaName="dbo" queryName="q_animal_req_order"/>
            <destination schemaName="nbri_ehr" queryName="AnimalReqOrder"
                         bulkLoad="true" targetOption="truncate">
                <columnTransforms>
                    <column source="RequisitionerStaff" target="RequisitionerStaff" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                    <column source="BillToStaff" target="BillToStaff" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                    <column source="PerDiemStaff" target="PerDiemStaff" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                    <column source="SubmittedByStaff" target="SubmittedByStaff" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                    <column source="ApprovedByStaff" target="ApprovedByStaff" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                    <column source="CreatedByStaff" target="CreatedByStaff" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                </columnTransforms>
            </destination>
        </transform>
        <transform id="step2" type="org.labkey.di.pipeline.TransformTask">
            <description>Copy to req order esignature target</description>
            <source schemaName="dbo" queryName="q_animal_req_order_esig"/>
            <destination schemaName="nbri_ehr" queryName="AnimalReqOrderEsig"
                         bulkLoad="true" batchSize="5000" targetOption="truncate">
                <columnTransforms>
                    <column source="UserProfile" target="UserProfile" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                </columnTransforms>
            </destination>
        </transform>
    </transforms>

    <schedule>
        <cron expression="0 0 20 * * ?" /> <!--Run at 8PM every day-->
    </schedule>
</etl>