<?xml version="1.0" encoding="UTF-8"?>
<etl xmlns="http://labkey.org/etl/xml">
    <name>Chemistry Results</name>
    <description>Chemistry Results</description>
    <transforms>
        <transform id="step1" type="org.labkey.di.pipeline.TransformTask">
            <description>Copy to chemistry results target</description>
            <source schemaName="dbo" queryName="q_chemistryResults"/>
            <destination schemaName="study" queryName="chemistryResults"
                         bulkLoad="true" batchSize="5000" targetOption="merge">
                <alternateKeys>
                    <column name="objectid"/>
                </alternateKeys>
                <columnTransforms>
                    <column source="administrationDate" target="date"/>
                    <column source="performedby" target="performedby" transformClass="org.labkey.nbri_ehr.columnTransform.NBRIUserCreateTransform"/>
                </columnTransforms>
            </destination>
        </transform>
    </transforms>

    <incrementalFilter className="ModifiedSinceFilterStrategy" timestampColumnName="modified" >
        <deletedRowsSource schemaName="dbo" queryName="q_chemistryResults_delete" timestampColumnName="modified"
                           deletedSourceKeyColumnName="objectid" targetKeyColumnName="objectid"/>
    </incrementalFilter>

    <schedule>
        <cron expression="0 0 20 * * ?" /> <!--Run at 8PM every day-->
    </schedule>
</etl>